# WebSocket upgrade map for Next.js HMR
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    client_max_body_size 50M;   # Allow large file uploads

    # ── Forwarded headers (Critical for CSRF & Auth) ──
    proxy_set_header Host              ${NGINX_HOST};
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header X-Forwarded-Host  ${NGINX_HOST};

    # ── WebSocket support ──
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # ── Python Backend: /api/py/ → backend:8000 ──
    location /api/py/ {
        proxy_pass http://backend:8000/;
    }

    # ── Frontend: everything else → frontend:3000 ──
    location / {
        proxy_pass http://frontend:3000;
    }
}
